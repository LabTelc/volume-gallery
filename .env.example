# Copy to .env and fill in real values before running docker compose.
# Every setting is listed here. Lines that start with "#" are optional and show the DEFAULT:
# remove the "#" only to change it. All settings in one table: docs/configuration.md

# =============================================================== required
# Signs login and download tokens (at least 32 characters; changing it signs everyone out).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VG_SECRET_KEY=

# First-run bootstrap admin account (only created if the user table is empty).
# After first login you can create further admins from the Users page and,
# if you like, blank this out / rotate the password.
VG_ADMIN_USER=admin
VG_ADMIN_PASSWORD=changeme

# Where the ZFS dataset backing /data is mounted on the TrueNAS host.
# =============================================================== folders on the host
# Where the app keeps its data (database, volumes, meshes, point clouds); mounted at /data.
# Default if unset: ./data   (on TrueNAS: the host path of the ZFS dataset backing /data)
VG_HOST_DATA_DIR=/mnt/tank/apps/volume-gallery/data

# Scratch directory: uploads are written there (by nginx, once), unpacked and converted;
# only the finished result lands in /data. It is mounted at /processing in the app, worker and
# nginx containers, so leave VG_PROCESSING_DIR blank (= /processing). Ideally point the host
# directory at a fast disk that is NOT the data dataset; budget about 2-3x the size of the
# largest upload in free space (see docs/usage_ui_guide.md and docs/architecture_internals.md).
VG_PROCESSING_DIR=
VG_HOST_PROCESSING_DIR=./processing

# Folder with branding.toml and the logo files (mounted read-only at /branding).
# VG_HOST_BRANDING_DIR=./branding

# Host folder with fullchain.pem + privkey.pem for nginx. Defaults to ./nginx/certs (where
# nginx/generate-self-signed-cert.sh writes to); override it if your certs live elsewhere
# (e.g. a TrueNAS certificate dataset) and you'd rather not copy them into this repo.
VG_CERT_DIR=./nginx/certs

# =============================================================== run as a non-root user
# Default 0:0 = root. On TrueNAS SCALE that is typically the "apps" user, 568:568. This one
# setting makes the app and the worker run as that user, makes nginx's worker processes run as
# the same user (required: nginx hands uploads to the app as files only that user can read), and
# has a one-shot init container chown the host directories behind VG_HOST_DATA_DIR /
# VG_HOST_PROCESSING_DIR for you.
# VG_UID=0
# VG_GID=0

# =============================================================== nginx (reverse proxy / HTTPS)
# See nginx/nginx.conf.template, nginx/generate-self-signed-cert.sh and docs/deployment_guide.md.
# Host ports nginx is reachable on. Default to something other than 80/443 since TrueNAS's own
# web UI commonly already occupies those. Change these back to 80/443 if nothing else needs them.
VG_HTTP_PORT=8080
VG_HTTPS_PORT=8443

# "off" streams uploads straight to disk (needed for very large files); "on" buffers them in nginx.
# VG_NGINX_REQUEST_BUFFERING=off

# =============================================================== job queue and conversion
# Redis queue the worker container reads. (Without a Redis URL, e.g. in truenas_app.yml, the
# web process converts uploads itself.)
# VG_REDIS_URL=redis://redis:6379/0
# Name of the queue; the app and the worker must use the same one.
# VG_QUEUE_NAME=volume-gallery

# Longest a queued conversion may run before it is killed, in hours (0 = no limit).
# VG_JOB_TIMEOUT_HOURS=72
# Longest a mesh or point cloud converter (nxsbuild, PotreeConverter) may run on one upload
# before the job is failed, in hours (0 = no limit).
# VG_CONVERTER_TIMEOUT_HOURS=24

# Longest side (px) of a mesh texture; larger ones are scaled down while converting (0 = keep).
# VG_MESH_MAX_TEXTURE_SIZE=8192
# Largest file (texture image, .mtl) that may be uploaded together with a mesh, in MB.
# VG_MESH_EXTRA_MAX_MB=256

# Hours after which an upload that was never turned into a volume / mesh / point cloud is
# deleted from the .uploads folders.
# VG_UPLOAD_STAGING_MAX_AGE_HOURS=24

# =============================================================== sign-in, tokens, sharing
# Login session length in minutes (480 = 8 hours).
VG_ACCESS_TOKEN_MINUTES=480
# Lifetime of the short token that authorizes a data / mesh download, in minutes.
VG_FILE_TOKEN_MINUTES=30
# Shortest password accepted when one is set or changed.
# VG_MIN_PASSWORD_LENGTH=8
# How long the link an admin creates (new user / password reset) works, in hours.
# VG_PASSWORD_LINK_HOURS=72
# Days the audit log is kept (0 = for ever).
# VG_AUDIT_RETENTION_DAYS=0
# Min and max character length of custom / generated share link codes (/s/<code>).
VG_SHARE_CODE_MIN_LENGTH=8
VG_SHARE_CODE_MAX_LENGTH=24

# =============================================================== performance and limits
# Largest accepted thumbnail upload (png / jpeg / webp), in MB.
# VG_THUMBNAIL_MAX_MB=5
# Seconds a scan of a volume's files is cached.
# VG_FILE_META_CACHE_TTL_SECONDS=60

# Slice views: RAM for decoded 64-plane slabs shared by all viewers (0 = no cache, much slower;
# a slab of a 2000^3 16-bit volume is ~512 MB), slabs decoded in parallel, and the zstd level
# (1 = fastest) for planes sent to browsers that accept it.
# VG_SLICE_CACHE_MB=2048
# VG_SLICE_BUILD_THREADS=2
# VG_SLICE_ZSTD_LEVEL=1

# Histograms (transfer function backdrop): threads used (empty = the smaller of 4 and the CPU
# count), and whether volumes without one get it computed in the background at start-up.
# VG_HISTOGRAM_THREADS=
# VG_HISTOGRAM_BACKFILL=1