@@ -26,19 +26,29 @@ export const DEFAULT_ATLAS_BUDGET_BYTES = 1_400_000_000;
 // LOD plus a working set.
 export const MIN_GRID_SIZE = 6;
 
+// Local patch: the atlas used to be capped at GRID_SIZE (10) slots per axis. It can now grow up to
+// MAX_GRID_SIZE, limited by the device's 3D texture dimension (maxTextureDim3D / PHYSICAL_BRICK_SIZE)
+// and the VRAM budget. Slot coordinates are stored in rgba8uint indirection texels, so anything
+// below 256 would work; 32 is already a >2 GB-per-channel atlas.
+export const MAX_GRID_SIZE = 32;
+
 /**
  * Largest atlas grid (slots/axis) whose VRAM (numChannels × atlasSize³ ×
- * bytesPerVoxel) fits budgetBytes, clamped to [MIN_GRID_SIZE, GRID_SIZE].
+ * bytesPerVoxel) fits budgetBytes, clamped to [MIN_GRID_SIZE, the largest grid the device's
+ * 3D texture limit allows (at most MAX_GRID_SIZE, and `gridLimit` when an allocation failed)].
  */
 export function computeAtlasGrid(
   numChannels: number,
   bytesPerVoxel: number,
   budgetBytes: number = DEFAULT_ATLAS_BUDGET_BYTES,
+  maxTextureDim3D: number = ATLAS_SIZE,
+  gridLimit: number = Infinity,
 ): { gridSize: number; atlasSize: number } {
+  const maxGrid = Math.min(MAX_GRID_SIZE, gridLimit, Math.max(GRID_SIZE, Math.floor(maxTextureDim3D / PHYSICAL_BRICK_SIZE)));
   const bytesPerChannel = budgetBytes / Math.max(1, numChannels);
   const voxelsPerChannel = bytesPerChannel / Math.max(1, bytesPerVoxel);
   const rawGrid = Math.floor(Math.cbrt(voxelsPerChannel) / PHYSICAL_BRICK_SIZE);
-  const gridSize = Math.max(MIN_GRID_SIZE, Math.min(GRID_SIZE, rawGrid));
+  const gridSize = Math.max(MIN_GRID_SIZE, Math.min(maxGrid, rawGrid));
   return { gridSize, atlasSize: gridSize * PHYSICAL_BRICK_SIZE };
 }
 
