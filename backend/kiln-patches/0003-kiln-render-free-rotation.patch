diff --git a/test/camera-free-rotation.test.ts b/test/camera-free-rotation.test.ts
new file mode 100644
index 0000000..f1e6819
--- /dev/null
+++ b/test/camera-free-rotation.test.ts
@@ -0,0 +1,54 @@
+/**
+ * Local patch: free rotation of the camera (see Camera.freeRotation).
+ */
+import { describe, it, expect } from 'vitest';
+import { Camera } from '../src/core/camera.js';
+
+const canvas = { addEventListener() {} } as unknown as HTMLCanvasElement;
+// What the mouse handler does for one drag step
+const orbit = (c: Camera, dx: number, dy: number, roll = false) => {
+  const priv = c as unknown as { applyOrbit(dx: number, dy: number, roll: boolean): void; updatePosition(): void };
+  priv.applyOrbit(dx, dy, roll);
+  priv.updatePosition();
+};
+
+describe('Camera free rotation', () => {
+  it('starts as the turntable view, so the state is the plain 6 numbers', () => {
+    expect(new Camera(canvas).getFullOrbitState()).toHaveLength(6);
+  });
+
+  it('rolling or turning over a pole gives the 12-number state, which restores the view', () => {
+    const a = new Camera(canvas);
+    orbit(a, 40, 20);
+    orbit(a, 30, 0, true);
+    const state = a.getFullOrbitState();
+    expect(state).toHaveLength(12);
+
+    const b = new Camera(canvas);
+    b.setOrbitState(state);
+    expect(Array.from(b.getViewMatrix())).toEqual(Array.from(a.getViewMatrix()));
+  });
+
+  it('turns over the pole instead of stopping short of it', () => {
+    const c = new Camera(canvas);
+    orbit(c, 0, 400);
+    // the screen up vector is no longer the up axis: the model went over the top
+    expect(c.getFullOrbitState()).toHaveLength(12);
+  });
+
+  it('is the turntable again with freeRotation off: the elevation is clamped', () => {
+    const c = new Camera(canvas);
+    c.setFreeRotation(false);
+    orbit(c, 0, 4000);
+    expect(Math.abs(c.getOrbitState()[0])).toBeLessThan(Math.PI / 2);
+    expect(c.getFullOrbitState()).toHaveLength(6);
+  });
+
+  it('lookFrom() puts the eye on the requested side', () => {
+    const c = new Camera(canvas);
+    c.lookFrom([1, 0, 0]);
+    expect(c.position[0]).toBeGreaterThan(0);
+    expect(Math.abs(c.position[1]!)).toBeLessThan(1e-4);
+    expect(Math.abs(c.position[2]!)).toBeLessThan(1e-4);
+  });
+});
