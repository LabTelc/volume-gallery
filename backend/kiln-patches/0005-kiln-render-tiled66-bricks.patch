diff --git a/test/brick-tiling.test.ts b/test/brick-tiling.test.ts
new file mode 100644
index 0000000..5f003a7
--- /dev/null
+++ b/test/brick-tiling.test.ts
@@ -0,0 +1,39 @@
+/**
+ * Local patch: tiled66 brick layout.
+ */
+import { describe, it, expect } from 'vitest';
+import { untileBrick66, TILED_BRICK_SIDE } from '../src/data/brick-tiling.js';
+
+const P = TILED_BRICK_SIDE;
+const B = [0, 17, 33, 49, 66];
+
+/** The converter's side: raster -> 64 contiguous sub-blocks (17/16/16/17 per axis, z-major, then y, then x). */
+function tile<T extends Uint8Array | Uint16Array>(raster: T): T {
+  const out = new (raster.constructor as new (n: number) => T)(raster.length);
+  let pos = 0;
+  for (let a = 0; a < 4; a++) for (let b = 0; b < 4; b++) for (let c = 0; c < 4; c++) {
+    for (let z = B[a]!; z < B[a + 1]!; z++) for (let y = B[b]!; y < B[b + 1]!; y++) {
+      for (let x = B[c]!; x < B[c + 1]!; x++) out[pos++] = raster[(z * P + y) * P + x]!;
+    }
+  }
+  return out;
+}
+
+describe('untileBrick66', () => {
+  it('restores the raster order of an 8-bit brick', () => {
+    const raster = Uint8Array.from({ length: P ** 3 }, (_, i) => (i * 31) & 255);
+    const restored = new Uint8Array(untileBrick66(tile(raster).buffer as ArrayBuffer));
+    expect(restored).toEqual(raster);
+  });
+
+  it('restores the raster order of a 16-bit brick', () => {
+    const raster = Uint16Array.from({ length: P ** 3 }, (_, i) => (i * 7919) & 0xffff);
+    const restored = new Uint16Array(untileBrick66(tile(raster).buffer as ArrayBuffer));
+    expect(restored).toEqual(raster);
+  });
+
+  it('leaves a buffer of any other size alone', () => {
+    const odd = new ArrayBuffer(100);
+    expect(untileBrick66(odd)).toBe(odd);
+  });
+});
