+/**
+ * Local patch: "tiled66" brick layout (written by the Volume Gallery converter for LOD 0).
+ *
+ * A brick is still 66³ voxels, but its decompressed bytes are 64 contiguous sub-blocks (17/16/16/17
+ * voxels per axis, z-major, then y, then x; each sub-block stored in C order) instead of one raster.
+ * `untileBrick66` turns them back into the raster the atlas upload expects.
+ */
+
+export const TILED_BRICK_SIDE = 66;
+
+// Sub-block boundaries along one axis: 17 + 16 + 16 + 17 = 66
+const BOUNDS = [0, 17, 33, 49, 66] as const;
+
+/** Raster order copy of a tiled66 brick. Returns the input unchanged when its size is not 66³ × 1 or 2 bytes. */
+export function untileBrick66(buffer: ArrayBuffer): ArrayBuffer {
+  const P = TILED_BRICK_SIDE;
+  const N = P * P * P;
+  const elem = buffer.byteLength / N;
+  if (elem !== 1 && elem !== 2) return buffer;
+  const src = elem === 1 ? new Uint8Array(buffer) : new Uint16Array(buffer);
+  const dst = elem === 1 ? new Uint8Array(N) : new Uint16Array(N);
+  let pos = 0;
+  for (let a = 0; a < 4; a++) {
+    for (let b = 0; b < 4; b++) {
+      for (let c = 0; c < 4; c++) {
+        const x0 = BOUNDS[c]!, x1 = BOUNDS[c + 1]!;
+        for (let z = BOUNDS[a]!; z < BOUNDS[a + 1]!; z++) {
+          for (let y = BOUNDS[b]!; y < BOUNDS[b + 1]!; y++) {
+            let d = (z * P + y) * P + x0;
+            for (let x = x0; x < x1; x++) dst[d++] = src[pos++]!;
+          }
+        }
+      }
+    }
+  }
+  return dst.buffer as ArrayBuffer;
+}
