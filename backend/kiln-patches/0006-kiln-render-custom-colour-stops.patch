diff --git a/test/transfer-function-color-stops.test.ts b/test/transfer-function-color-stops.test.ts
new file mode 100644
index 0000000..0fcedf7
--- /dev/null
+++ b/test/transfer-function-color-stops.test.ts
@@ -0,0 +1,51 @@
+/**
+ * Local patch: custom colour stops of the transfer function.
+ */
+import { describe, it, expect } from 'vitest';
+import { TransferFunction } from '../src/core/transfer-function.js';
+
+const fakeDevice = {
+  createTexture: () => ({ destroy() {} }),
+  queue: { writeTexture() {} },
+} as unknown as GPUDevice;
+(globalThis as { GPUTextureUsage?: unknown }).GPUTextureUsage ??= { TEXTURE_BINDING: 4, COPY_DST: 2 };
+
+describe('TransferFunction colour stops', () => {
+  it('interpolates linearly between the stops and switches to the custom preset', () => {
+    const tf = new TransferFunction(fakeDevice);
+    const stops = tf.setColorStops([{ pos: 0, color: '#000000' }, { pos: 1, color: '#ff0000' }]);
+    expect(tf.preset).toBe('custom');
+    expect(stops).toEqual([{ pos: 0, color: '#000000' }, { pos: 1, color: '#ff0000' }]);
+    expect(tf.getColor(0)).toEqual([0, 0, 0]);
+    expect(tf.getColor(1)).toEqual([255, 0, 0]);
+    expect(tf.getColor(0.5)[0]).toBeGreaterThanOrEqual(127);
+    expect(tf.getColor(0.5)[0]).toBeLessThanOrEqual(128);
+  });
+
+  it('adds the missing end points, accepts [r, g, b], and sorts unordered stops', () => {
+    const tf = new TransferFunction(fakeDevice);
+    const stops = tf.setColorStops([{ pos: 0.8, color: [0, 0, 255] }, { pos: 0.2, color: '#00ff00' }]);
+    expect(stops).toEqual([
+      { pos: 0, color: '#00ff00' }, { pos: 0.2, color: '#00ff00' },
+      { pos: 0.8, color: '#0000ff' }, { pos: 1, color: '#0000ff' },
+    ]);
+  });
+
+  it('drops invalid stops, and changes nothing when none is valid', () => {
+    const tf = new TransferFunction(fakeDevice);
+    expect(tf.setColorStops([{ pos: 0.5, color: 'red' }, { pos: NaN, color: '#ffffff' }])).toBeNull();
+    expect(tf.preset).toBe('grayscale');
+    expect(tf.getColorStops()).toBeNull();
+  });
+
+  it('a built-in preset clears the stops; setPreset("custom") restores them', () => {
+    const tf = new TransferFunction(fakeDevice);
+    tf.setColorStops([{ pos: 0, color: '#112233' }, { pos: 1, color: '#445566' }]);
+    tf.setPreset('hot');
+    expect(tf.getColorStops()).toBeNull();
+    tf.setColorStops([{ pos: 0, color: '#112233' }, { pos: 1, color: '#445566' }]);
+    tf.setPreset('custom');
+    expect(tf.preset).toBe('custom');
+    expect(tf.getColor(0)).toEqual([0x11, 0x22, 0x33]);
+  });
+});
