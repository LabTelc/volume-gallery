+   * preset becomes 'custom'. The opacity curve is left alone. Stops are { pos, color } with color
+   * '#rrggbb' or [r, g, b] (0–255); invalid entries are dropped, positions are clamped and sorted, and
+   * missing end points at 0 and 1 are added with the nearest colour. Returns the normalised stops
+   * (hex colours), or null (nothing changed) if no valid stop was given.
+   */
+  setColorStops(stops: ReadonlyArray<{ pos: number; color: string | readonly number[] }>): ColorStop[] | null {
+    const hex = /^#[0-9a-f]{6}$/i;
+    const toRgb = (c: unknown): [number, number, number] | null => {
+      if (typeof c === 'string' && hex.test(c)) {
+        const n = parseInt(c.slice(1), 16);
+        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+      }
+      if (Array.isArray(c) && c.length >= 3 && c.slice(0, 3).every(Number.isFinite)) {
+        const v = c.slice(0, 3).map(x => Math.round(Math.min(255, Math.max(0, x as number))));
+        return [v[0]!, v[1]!, v[2]!];
+      }
+      return null;
+    };
+    const ok: Array<{ pos: number; rgb: [number, number, number] }> = [];
+    for (const s of stops ?? []) {
+      const rgb = s && Number.isFinite(s.pos) ? toRgb(s.color) : null;
+      if (rgb) ok.push({ pos: Math.min(1, Math.max(0, s.pos)), rgb });
+    }
+    if (!ok.length) return null;
+    ok.sort((a, b) => a.pos - b.pos);
