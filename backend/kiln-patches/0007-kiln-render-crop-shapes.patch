diff --git a/src/shaders/crop.wgsl b/src/shaders/crop.wgsl
new file mode 100644
index 0000000..2b10745
--- /dev/null
+++ b/src/shaders/crop.wgsl
@@ -0,0 +1,87 @@
+// Crop shapes (plane, box, cylinder, sphere): parts of the volume that are not drawn.
+// Compute shader only (reads uniforms.cropCount / uniforms.cropShapes). The shape table is packed by
+// packCropShapes() in core/crop.ts: per shape CROP_SHAPE_VECS vec4f
+//   0: (type id, 1 = the outside is removed, -, -)   1: world centre   2: size
+//   3, 4, 5: the local X, Y, Z axes in world space
+// Everything is in world space (the volume box is centred on the origin, longest side 1).
+
+const CROP_PLANE: u32 = 1u;
+const CROP_BOX: u32 = 2u;
+const CROP_CYLINDER: u32 = 3u;
+
+// Signed distance to the surface of shape i: negative inside, positive outside.
+fn cropSignedDistance(i: u32, pos: vec3f) -> f32 {
+    let base = i * CROP_SHAPE_VECS;
+    let kind = u32(uniforms.cropShapes[base].x);
+    let d = pos - uniforms.cropShapes[base + 1u].xyz;
+    let size = uniforms.cropShapes[base + 2u].xyz;
+    let local = vec3f(
+        dot(uniforms.cropShapes[base + 3u].xyz, d),
+        dot(uniforms.cropShapes[base + 4u].xyz, d),
+        dot(uniforms.cropShapes[base + 5u].xyz, d)
+    );
+
+    if (kind == CROP_PLANE) {
+        return local.z;
+    }
+    if (kind == CROP_BOX) {
+        let q = abs(local) - size;
+        return length(max(q, vec3f(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
+    }
+    if (kind == CROP_CYLINDER) {
+        // axis = local Z; size = (radius, half height)
+        let q = vec2f(length(local.xy) - size.x, abs(local.z) - size.y);
+        return min(max(q.x, q.y), 0.0) + length(max(q, vec2f(0.0)));
+    }
+    return length(local) - size.x;   // sphere
+}
+
+// True when shape i removes the position.
+fn cropShapeRemoves(i: u32, pos: vec3f) -> bool {
+    let sd = cropSignedDistance(i, pos);
+    if (uniforms.cropShapes[i * CROP_SHAPE_VECS].y > 0.5) {
+        return sd > 0.0;   // 'outside': only the inside is kept
+    }
+    return sd <= 0.0;      // 'inside': the inside is cut away
+}
+
+// True when any enabled shape removes the position (no shapes: always false, a loop of zero iterations).
+fn cropIsRemoved(pos: vec3f) -> bool {
+    for (var i = 0u; i < uniforms.cropCount; i++) {
+        if (cropShapeRemoves(i, pos)) { return true; }
+    }
+    return false;
+}
+
+// First kept position between a removed one (tRemoved) and a kept one (tKept) on the ray, by bisection.
+fn refineCropBoundary(rayOrigin: vec3f, rayDir: vec3f, tRemoved: f32, tKept: f32) -> f32 {
+    var lo = tRemoved;
+    var hi = tKept;
+    for (var i = 0u; i < 8u; i++) {
+        let mid = (lo + hi) * 0.5;
+        if (cropIsRemoved(rayOrigin + rayDir * mid)) { lo = mid; } else { hi = mid; }
+    }
+    return hi;
+}
+
+// Normal of the cut face at a position on the boundary of the cropped region: the surface of the nearest
+// shape, pointing out of the material that is kept (into the part that was cut away).
+fn cropBoundaryNormal(pos: vec3f) -> vec3f {
+    var best = 1e30;
+    var nearest = 0u;
+    for (var i = 0u; i < uniforms.cropCount; i++) {
+        let a = abs(cropSignedDistance(i, pos));
+        if (a < best) { best = a; nearest = i; }
+    }
+    let e = 0.002;
+    let g = vec3f(
+        cropSignedDistance(nearest, pos + vec3f(e, 0.0, 0.0)) - cropSignedDistance(nearest, pos - vec3f(e, 0.0, 0.0)),
+        cropSignedDistance(nearest, pos + vec3f(0.0, e, 0.0)) - cropSignedDistance(nearest, pos - vec3f(0.0, e, 0.0)),
+        cropSignedDistance(nearest, pos + vec3f(0.0, 0.0, e)) - cropSignedDistance(nearest, pos - vec3f(0.0, 0.0, e))
+    );
+    if (length(g) < 1e-9) { return vec3f(0.0, 0.0, 1.0); }
+    // 'inside' removed: the kept material is where the distance grows, so it faces down the gradient;
+    // 'outside' removed: the kept material is inside and its surface faces up the gradient.
+    if (uniforms.cropShapes[nearest * CROP_SHAPE_VECS].y > 0.5) { return normalize(g); }
+    return -normalize(g);
+}
