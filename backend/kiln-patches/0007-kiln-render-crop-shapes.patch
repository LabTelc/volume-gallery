diff --git a/test/crop.test.ts b/test/crop.test.ts
new file mode 100644
index 0000000..138c40d
--- /dev/null
+++ b/test/crop.test.ts
@@ -0,0 +1,169 @@
+/**
+ * Crop shapes — the CPU side: defaults and sanitising, the packing the compute shader reads, and the
+ * signed distances / removal rule (the shader's twin; the two are compared on a GPU outside this suite).
+ */
+import { describe, it, expect } from 'vitest';
+import {
+  resolveCropShape, resolveCropShapes, packCropShapes, cropAxes, cropSignedDistance, cropShapeRemoves,
+  isCropRemoved, MAX_CROP_SHAPES, CROP_SHAPE_VECS,
+} from '../src/core/crop.js';
+import { COMPUTE_UNIFORMS } from '../src/shaders/uniform-layout.js';
+
+const NS: [number, number, number] = [1, 0.5, 0.25]; // a flat, elongated volume box
+
+describe('resolveCropShape', () => {
+  it('fills in defaults per type', () => {
+    expect(resolveCropShape({ type: 'sphere' })).toEqual({
+      type: 'sphere', enabled: true, mode: 'inside', center: [0.5, 0.5, 0.5], size: [0.25, 0, 0], rotation: [0, 0, 0],
+    });
+    expect(resolveCropShape({ type: 'box' })!.size).toEqual([0.25, 0.25, 0.25]);
+    expect(resolveCropShape({ type: 'cylinder' })!.size).toEqual([0.25, 0.25, 0]);
+    expect(resolveCropShape({ type: 'plane' })!.size).toEqual([0, 0, 0]);
+  });
+
+  it('rejects unknown types (including inherited property names) and null', () => {
+    expect(resolveCropShape({ type: 'cone' as never })).toBeNull();
+    expect(resolveCropShape({ type: 'toString' as never })).toBeNull();
+    expect(resolveCropShape(null)).toBeNull();
+    expect(resolveCropShape(undefined)).toBeNull();
+  });
+
+  it('sanitises numbers: non-finite values fall back, sizes cannot be negative', () => {
+    const s = resolveCropShape({ type: 'box', center: [NaN, 0.2, Infinity] as never, size: [-1, 0.3, 'x' as never], mode: 'bogus' as never })!;
+    expect(s.center).toEqual([0.5, 0.2, 0.5]);
+    expect(s.size).toEqual([0, 0.3, 0.25]);
+    expect(s.mode).toBe('inside');
+  });
+
+  it('keeps enabled=false and mode=outside', () => {
+    const s = resolveCropShape({ type: 'plane', enabled: false, mode: 'outside' })!;
+    expect(s.enabled).toBe(false);
+    expect(s.mode).toBe('outside');
+  });
+});
+
+describe('resolveCropShapes', () => {
+  it('skips invalid entries and keeps at most MAX_CROP_SHAPES', () => {
+    const many = Array.from({ length: MAX_CROP_SHAPES + 3 }, () => ({ type: 'sphere' as const }));
+    expect(resolveCropShapes(many)).toHaveLength(MAX_CROP_SHAPES);
+    expect(resolveCropShapes([{ type: 'nope' as never }, { type: 'box' }])).toHaveLength(1);
+    expect(resolveCropShapes(null)).toEqual([]);
+  });
+});
+
+describe('cropAxes', () => {
+  it('is the identity for no rotation', () => {
+    expect(cropAxes([0, 0, 0])).toEqual([[1, 0, 0], [0, 1, 0], [0, 0, 1]]);
+  });
+
+  it('turns local +Z onto +X for ry = 90 and onto +Y for rx = -90', () => {
+    const close = (a: number[], b: number[]) => a.forEach((v, i) => expect(v).toBeCloseTo(b[i]!, 6));
+    close(cropAxes([0, 90, 0])[2], [1, 0, 0]);
+    close(cropAxes([-90, 0, 0])[2], [0, 1, 0]);
+    close(cropAxes([0, 0, 90])[0], [0, 1, 0]);
+  });
+
+  it('gives an orthonormal frame for any angles', () => {
+    const [x, y, z] = cropAxes([33, -71, 120]);
+    const dot = (a: number[], b: number[]) => a[0]! * b[0]! + a[1]! * b[1]! + a[2]! * b[2]!;
+    expect(dot(x, x)).toBeCloseTo(1, 6);
+    expect(dot(x, y)).toBeCloseTo(0, 6);
+    expect(dot(y, z)).toBeCloseTo(0, 6);
+    expect(dot(x, z)).toBeCloseTo(0, 6);
+  });
+});
+
+describe('packCropShapes', () => {
+  it('writes only enabled shapes, in the layout of crop.wgsl, and reports the count', () => {
+    const out = new Float32Array(MAX_CROP_SHAPES * CROP_SHAPE_VECS * 4).fill(7);
+    const shapes = resolveCropShapes([
+      { type: 'sphere', enabled: false },
+      { type: 'cylinder', mode: 'outside', center: [1, 0.5, 0], size: [0.1, 0.2, 0], rotation: [0, 90, 0] },
+    ]);
+    expect(packCropShapes(shapes, NS, out)).toBe(1);
+    // vec4 0: (type id 3 = cylinder, outside = 1)
+    expect(Array.from(out.slice(0, 4))).toEqual([3, 1, 0, 0]);
+    // vec4 1: world centre = (c - 0.5) * normalizedSize
+    expect(Array.from(out.slice(4, 7))).toEqual([0.5, 0, -0.125]);
+    // vec4 2: size
+    expect(Array.from(out.slice(8, 11)).map((v) => +v.toFixed(6))).toEqual([0.1, 0.2, 0]);
+    // vec4 3..5: local axes; ry = 90 turns Z onto X
+    expect(out[20]).toBeCloseTo(1, 6);
+    // the rest of the table is cleared
+    expect(Array.from(out.slice(CROP_SHAPE_VECS * 4)).every((v) => v === 0)).toBe(true);
+  });
+
+  it('fits the compute uniform struct', () => {
+    expect(COMPUTE_UNIFORMS.offsets.cropShapes + MAX_CROP_SHAPES * CROP_SHAPE_VECS * 16).toBe(COMPUTE_UNIFORMS.size);
+    expect(COMPUTE_UNIFORMS.offsets.cropCount).toBe(COMPUTE_UNIFORMS.offsets.pickPixel + 8);   // right after pickPixel's vec2f
+  });
+});
+
+describe('cropSignedDistance', () => {
+  const at = (type: 'plane' | 'box' | 'cylinder' | 'sphere', extra = {}) =>
+    resolveCropShape({ type, center: [0.5, 0.5, 0.5], size: [0.2, 0.1, 0.05], ...extra })!;
+
+  it('plane: distance along its normal (local Z), negative behind it', () => {
+    const p = at('plane');
+    expect(cropSignedDistance(p, NS, [0, 0, 0.1])).toBeCloseTo(0.1, 6);
+    expect(cropSignedDistance(p, NS, [0.3, -0.2, -0.04])).toBeCloseTo(-0.04, 6);
+  });
+
+  it('sphere: distance to the surface', () => {
+    const s = at('sphere');
+    expect(cropSignedDistance(s, NS, [0, 0, 0])).toBeCloseTo(-0.2, 6);
+    expect(cropSignedDistance(s, NS, [0.5, 0, 0])).toBeCloseTo(0.3, 6);
+  });
+
+  it('box: negative inside, exact distance to a face and to a corner outside', () => {
+    const b = at('box');
+    expect(cropSignedDistance(b, NS, [0, 0, 0])).toBeCloseTo(-0.05, 6);
+    expect(cropSignedDistance(b, NS, [0.3, 0, 0])).toBeCloseTo(0.1, 6);
+    expect(cropSignedDistance(b, NS, [0.3, 0.2, 0.05])).toBeCloseTo(Math.hypot(0.1, 0.1), 6);
+  });
+
+  it('cylinder: radius in local XY, half height along local Z', () => {
+    const c = at('cylinder', { size: [0.2, 0.1, 0] });
+    expect(cropSignedDistance(c, NS, [0, 0, 0])).toBeCloseTo(-0.1, 6);
+    expect(cropSignedDistance(c, NS, [0.3, 0, 0])).toBeCloseTo(0.1, 6);
+    expect(cropSignedDistance(c, NS, [0, 0, 0.3])).toBeCloseTo(0.2, 6);
+    // axis turned onto world X: now the length is along X
+    const turned = at('cylinder', { size: [0.2, 0.1, 0], rotation: [0, 90, 0] });
+    expect(cropSignedDistance(turned, NS, [0.05, 0, 0])).toBeLessThan(0);
+    expect(cropSignedDistance(turned, NS, [0, 0, 0.3])).toBeCloseTo(0.1, 6);
+  });
+});
+
+describe('removal rule', () => {
+  const sphere = (mode: 'inside' | 'outside', enabled = true) =>
+    resolveCropShape({ type: 'sphere', mode, enabled, center: [0.5, 0.5, 0.5], size: [0.2, 0, 0] })!;
+
+  it("'inside' removes the inside, 'outside' removes everything else", () => {
+    expect(cropShapeRemoves(sphere('inside'), NS, [0, 0, 0])).toBe(true);
+    expect(cropShapeRemoves(sphere('inside'), NS, [0.4, 0, 0])).toBe(false);
+    expect(cropShapeRemoves(sphere('outside'), NS, [0, 0, 0])).toBe(false);
+    expect(cropShapeRemoves(sphere('outside'), NS, [0.4, 0, 0])).toBe(true);
+  });
+
+  it('a disabled shape removes nothing', () => {
+    expect(cropShapeRemoves(sphere('inside', false), NS, [0, 0, 0])).toBe(false);
+    expect(cropShapeRemoves(sphere('outside', false), NS, [0.4, 0, 0])).toBe(false);
+  });
+
+  it('a plane with the default mode keeps the side its normal points to', () => {
+    const plane = [{ type: 'plane' as const }];
+    expect(isCropRemoved(plane, NS, [0, 0, -0.05])).toBe(true);
+    expect(isCropRemoved(plane, NS, [0, 0, 0.05])).toBe(false);
+  });
+
+  it('several shapes remove the union of what each removes', () => {
+    const two = [
+      { type: 'sphere' as const, mode: 'inside' as const, center: [0.2, 0.5, 0.5] as [number, number, number], size: [0.1, 0, 0] as [number, number, number] },
+      { type: 'sphere' as const, mode: 'inside' as const, center: [0.8, 0.5, 0.5] as [number, number, number], size: [0.1, 0, 0] as [number, number, number] },
+    ];
+    expect(isCropRemoved(two, NS, [-0.3, 0, 0])).toBe(true);
+    expect(isCropRemoved(two, NS, [0.3, 0, 0])).toBe(true);
+    expect(isCropRemoved(two, NS, [0, 0, 0])).toBe(false);
+    expect(isCropRemoved([], NS, [0, 0, 0])).toBe(false);
+  });
+});
