index 0000000..7041432
--- /dev/null
+++ b/src/core/crop.ts
@@ -0,0 +1,177 @@
+/**
+ * Crop shapes — plane, box, cylinder and sphere that remove part of the volume from the 3D render.
+ *
+ * A shape removes either its inside (`mode: 'inside'`: a hole is cut) or everything outside it
+ * (`mode: 'outside'`: only what lies inside the shape is kept). Several shapes combine by union of
+ * what they remove, so a voxel is drawn only if no enabled shape removes it. Crop shapes act on the
+ * 3D ray-marched modes (DVR, MIP, ISO, LOD); the slice planes are not cropped.
+ *
+ * Coordinates:
+ *  - `center` is a fraction 0..1 of the volume box (like clipMin/clipMax); for a plane it is a point on the plane.
+ *  - `size` is in world units, where the longest side of the volume box is 1 (so a sphere of radius 0.5
+ *    just fits a cubic volume, whatever its voxel spacing): box = half extents (x, y, z), cylinder =
+ *    [radius, half height, unused], sphere = [radius, unused, unused], plane = unused.
+ *  - `rotation` is Euler angles in degrees, applied as Rz · Ry · Rx. The shape's local axes are the
+ *    rotated X, Y, Z: the cylinder's axis is local Z and the plane's normal is local +Z. The plane's
+ *    "inside" is its back, the side local -Z, so with `mode: 'inside'` the side the normal points to is kept.
+ *
+ * This file also holds the packing that the compute shader reads (see crop.wgsl) and a CPU
+ * implementation of the same signed distances, used by the tests and by hosts that pick points in 3D.
+ */
+
+export type CropShapeType = 'plane' | 'box' | 'cylinder' | 'sphere';
+export type CropMode = 'inside' | 'outside';
+type Vec3 = [number, number, number];
+
+export interface CropShape {
+  type: CropShapeType;
+  /** A disabled shape stays in the list but removes nothing (default true). */
+  enabled?: boolean;
+  /** Which part is removed: the shape's 'inside' (default) or everything 'outside' it. */
+  mode?: CropMode;
+  /** Centre as a fraction 0..1 of the volume box (default [0.5, 0.5, 0.5]). */
+  center?: Vec3;
+  /** Extent in world units (longest volume side = 1); meaning depends on the type, see above. */
+  size?: Vec3;
+  /** Euler angles in degrees (default [0, 0, 0]). */
+  rotation?: Vec3;
+}
+
+/** A CropShape with every field filled in and sanitised. */
+export interface ResolvedCropShape {
+  type: CropShapeType;
+  enabled: boolean;
+  mode: CropMode;
+  center: Vec3;
+  size: Vec3;
+  rotation: Vec3;
+}
+
+/** The shader's shape table holds this many shapes; further ones are dropped. */
+export const MAX_CROP_SHAPES = 8;
+/** vec4f slots one shape takes in the uniform buffer: kind, centre, size and the three local axes. */
+export const CROP_SHAPE_VECS = 6;
+
+export const CROP_TYPE_IDS: Record<CropShapeType, number> = { plane: 1, box: 2, cylinder: 3, sphere: 4 };
+
+const DEFAULT_SIZE: Record<CropShapeType, Vec3> = {
+  plane: [0, 0, 0],
+  box: [0.25, 0.25, 0.25],
+  cylinder: [0.25, 0.25, 0],
+  sphere: [0.25, 0, 0],
+};
+
+const finite = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v);
+
+function vec3(v: unknown, fallback: Vec3, lo: number, hi: number): Vec3 {
+  const a = Array.isArray(v) ? v : [];
+  return [0, 1, 2].map((i) => (finite(a[i]) ? Math.min(hi, Math.max(lo, a[i] as number)) : fallback[i]!)) as Vec3;
+}
+
+/** Fills in defaults and clamps values; null when `shape` is not a known shape type. */
+export function resolveCropShape(shape: CropShape | null | undefined): ResolvedCropShape | null {
+  if (!shape || !Object.prototype.hasOwnProperty.call(CROP_TYPE_IDS, shape.type)) return null;
+  const type = shape.type;
+  return {
+    type,
+    enabled: shape.enabled !== false,
+    mode: shape.mode === 'outside' ? 'outside' : 'inside',
+    center: vec3(shape.center, [0.5, 0.5, 0.5], -4, 5),
+    size: vec3(shape.size, DEFAULT_SIZE[type], 0, 8),
+    rotation: vec3(shape.rotation, [0, 0, 0], -3600, 3600),
+  };
+}
+
+/** Resolves a list (invalid entries are skipped, at most MAX_CROP_SHAPES are kept). */
+export function resolveCropShapes(shapes: readonly (CropShape | null | undefined)[] | null | undefined): ResolvedCropShape[] {
+  const out: ResolvedCropShape[] = [];
+  for (const s of shapes ?? []) {
+    const r = resolveCropShape(s);
+    if (r && out.length < MAX_CROP_SHAPES) out.push(r);
+  }
+  return out;
+}
+
+/** The shape's local X, Y and Z axes in world space (the columns of Rz · Ry · Rx), from Euler angles in degrees. */
+export function cropAxes(rotation: Vec3): [Vec3, Vec3, Vec3] {
+  const [rx, ry, rz] = rotation.map((d) => (d * Math.PI) / 180) as Vec3;
+  const [cx, sx, cy, sy, cz, sz] = [Math.cos(rx), Math.sin(rx), Math.cos(ry), Math.sin(ry), Math.cos(rz), Math.sin(rz)];
+  const rot = (v: Vec3): Vec3 => {
+    let [x, y, z] = v;
+    [y, z] = [y * cx - z * sx, y * sx + z * cx]; // Rx
+    [x, z] = [x * cy + z * sy, -x * sy + z * cy]; // Ry
+    [x, y] = [x * cz - y * sz, x * sz + y * cz]; // Rz
+    return [x, y, z];
+  };
+  return [rot([1, 0, 0]), rot([0, 1, 0]), rot([0, 0, 1])];
+}
+
+/** World-space centre of a shape (the volume box is centred on the origin, extents `normalizedSize`). */
+function worldCentre(shape: ResolvedCropShape, normalizedSize: Vec3): Vec3 {
+  return shape.center.map((c, i) => (c - 0.5) * normalizedSize[i]!) as Vec3;
+}
+
+/**
+ * Writes the enabled shapes in the layout of crop.wgsl into `out` (MAX_CROP_SHAPES * CROP_SHAPE_VECS * 4
+ * floats) and returns how many were written. Per shape, six vec4f:
+ *   0: (type id, 1 if the outside is removed, 0, 0)   1: world centre   2: size
+ *   3, 4, 5: the local X, Y, Z axes in world space (so local = (dot(axisX, d), dot(axisY, d), dot(axisZ, d)))
+ */
+export function packCropShapes(shapes: readonly ResolvedCropShape[], normalizedSize: Vec3, out: Float32Array): number {
+  out.fill(0);
+  let n = 0;
+  for (const s of shapes) {
+    if (!s.enabled || n >= MAX_CROP_SHAPES) continue;
+    const base = n * CROP_SHAPE_VECS * 4;
+    const [ax, ay, az] = cropAxes(s.rotation);
+    out.set([CROP_TYPE_IDS[s.type], s.mode === 'outside' ? 1 : 0, 0, 0], base);
+    out.set(worldCentre(s, normalizedSize), base + 4);
+    out.set(s.size, base + 8);
+    out.set(ax, base + 12);
+    out.set(ay, base + 16);
+    out.set(az, base + 20);
+    n++;
+  }
+  return n;
+}
+
+/**
+ * Signed distance from world position `p` to the shape's surface: negative inside, positive outside
+ * (exact for the plane and the sphere, a close bound elsewhere). CPU twin of cropSignedDistance() in crop.wgsl.
+ */
+export function cropSignedDistance(shape: ResolvedCropShape, normalizedSize: Vec3, p: Vec3): number {
+  const c = worldCentre(shape, normalizedSize);
+  const d: Vec3 = [p[0] - c[0], p[1] - c[1], p[2] - c[2]];
+  const [ax, ay, az] = cropAxes(shape.rotation);
+  const dot = (a: Vec3) => a[0] * d[0] + a[1] * d[1] + a[2] * d[2];
+  const l: Vec3 = [dot(ax), dot(ay), dot(az)];
+  const [sx, sy, sz] = shape.size;
+  switch (shape.type) {
+    case 'plane':
+      return l[2];
+    case 'box': {
+      const q = [Math.abs(l[0]) - sx, Math.abs(l[1]) - sy, Math.abs(l[2]) - sz];
+      const outer = Math.hypot(Math.max(q[0]!, 0), Math.max(q[1]!, 0), Math.max(q[2]!, 0));
+      return outer + Math.min(Math.max(q[0]!, q[1]!, q[2]!), 0);
+    }
+    case 'cylinder': {
+      const q = [Math.hypot(l[0], l[1]) - sx, Math.abs(l[2]) - sy];
+      return Math.min(Math.max(q[0]!, q[1]!), 0) + Math.hypot(Math.max(q[0]!, 0), Math.max(q[1]!, 0));
+    }
+    default:
+      return Math.hypot(l[0], l[1], l[2]) - sx;
+  }
+}
+
+/** Whether `shape` removes world position `p` (a disabled shape removes nothing). CPU twin of the shader's test. */
+export function cropShapeRemoves(shape: ResolvedCropShape, normalizedSize: Vec3, p: Vec3): boolean {
+  if (!shape.enabled) return false;
+  const sd = cropSignedDistance(shape, normalizedSize, p);
+  return shape.mode === 'outside' ? sd > 0 : sd <= 0;
+}
+
+/** Whether any shape removes world position `p` — for picking points in 3D the way the renderer shows them. */
+export function isCropRemoved(shapes: readonly CropShape[] | null | undefined, normalizedSize: Vec3, p: Vec3): boolean {
+  for (const s of resolveCropShapes(shapes)) if (cropShapeRemoves(s, normalizedSize, p)) return true;
+  return false;
+}
